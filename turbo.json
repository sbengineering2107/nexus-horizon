{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_SITE_URL", "VERCEL_ENV"],
      "outputs": [".next/**", "!.next/cache/**", ".velite/**", "public/static/**"]
    },
    "dev": { "cache": false, "persistent": true },
    "lint": {},
    "typecheck": {},
    "test": {},
    "e2e": { "cache": false }
  }
}
